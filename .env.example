# Copy this file to .env:
#     Windows PowerShell:  Copy-Item .env.example .env
#     macOS / Linux:       cp .env.example .env
#
# The defaults below are chosen so that a straight copy WORKS WITH NO SETUP --
# no Docker, no Qdrant server, no MongoDB. Uncomment things only when you
# actually want to point at real services.
#
# .env is gitignored — never commit real credentials.


# ---------------------------------------------------------------------------
# Qdrant vector store
# ---------------------------------------------------------------------------
# LEAVE QDRANT_URL COMMENTED OUT for local development.
#
# Unset  -> embedded file-backed Qdrant in ./qdrant_data (no server needed).
# Set    -> connect to that Qdrant server, and fail if it is not reachable.
#
# Setting it to localhost when nothing is listening there is the worst of both
# worlds: it disables the embedded fallback AND cannot connect. So it stays
# commented until you have actually started a server.
#
# Option A — local Qdrant via Docker (no API key):
#     docker run -p 6333:6333 qdrant/qdrant
#   then uncomment:
# QDRANT_URL=http://localhost:6333
#
# Option B — Qdrant Cloud (free tier at https://cloud.qdrant.io):
# QDRANT_URL=https://<your-cluster>.qdrant.io:6333
# QDRANT_API_KEY=<your-api-key>


# ---------------------------------------------------------------------------
# MongoDB (optional — incident persistence)
# ---------------------------------------------------------------------------
# Safe to leave as-is. If unreachable, db/mongo.py falls back to an in-memory
# store and the pipeline keeps running; incidents just are not persisted.
MONGODB_URI=mongodb://localhost:27017
